        "typeVersion": 3.5,
        "position": [240, 304],
        "parameters": { "assignments": { "assignments": [
          { "id": "name", "name": "name", "value": "={{ $json.name }}", "type": "string" },
          { "id": "service", "name": "service", "value": "={{ $json.service }}", "type": "string" },
          { "id": "budget", "name": "budget", "value": "={{ $json.budget }}", "type": "string" },
          { "id": "phone", "name": "phone", "value": "={{ $json.phone }}", "type": "string" },
          { "id": "phoneDigits", "name": "phoneDigits", "value": "={{ String($json.phone || '').replace(/[^0-9]/g, '') }}", "type": "string" },
          { "id": "budgetText", "name": "budgetText", "value": "={{ String($json.budget || '').trim() }}", "type": "string" },
          { "id": "submittedAt", "name": "submittedAt", "value": "={{ $now.toISO() }}", "type": "string" }
        ] }, "options": {} }
      },
      {
        "name": "Valid Enquiry?",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2.3,
        "position": [480, 304],
        "parameters": { "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
          "combinator": "and",
          "conditions": [
            { "id": "phone-ten-digits", "leftValue": "={{ $json.phoneDigits.length }}", "operator": { "type": "number", "operation": "equals" }, "rightValue": 10 },
